# Supabase Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Public Anon Key (safe for client side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Service Role Key (server side only, NEVER share in client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication (Required for /admin login and session HMAC signing)
ADMIN_EMAIL=admin@yourassociation.org
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=your-32-char-random-secret-for-session-signing

# Optional Cron Security Key (for /api/cron/keepalive)
CRON_SECRET=your-cron-secret-token

# Village & Association Name Customization
NEXT_PUBLIC_ASSOCIATION_NAME=Lambodara Utsav Association
NEXT_PUBLIC_VILLAGE_NAME=Papi Reddy Palli

# Dedicated Admin Domain / Subdomain (e.g. admin.lambodarautsav.org)
# When set, any /admin access on public domain automatically redirects to this domain
NEXT_PUBLIC_ADMIN_DOMAIN=admin.lambodarautsav.org
ADMIN_DOMAIN=admin.lambodarautsav.org

# Cloudflare R2 Object Storage (for image uploads — free tier: 10GB storage, ZERO egress fees)
# Setup: Cloudflare Dashboard → R2 → Create Bucket → Enable Public Access → Create API Token
# Docs: https://developers.cloudflare.com/r2/
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lambodara-media
# Public URL: either https://pub-xxxx.r2.dev (R2 public URL) or your custom domain
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
