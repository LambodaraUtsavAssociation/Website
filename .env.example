# Supabase Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Public Anon Key (safe for client side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Service Role Key (server side only, NEVER share in client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Village & Association Name Customization
NEXT_PUBLIC_ASSOCIATION_NAME=Lambodara Utsav Association
NEXT_PUBLIC_VILLAGE_NAME=Papi Reddy Palli

# Dedicated Admin Domain / Subdomain (e.g. admin.lambodarautsav.org)
# When set, any /admin access on public domain automatically redirects to this domain
NEXT_PUBLIC_ADMIN_DOMAIN=admin.lambodarautsav.org
ADMIN_DOMAIN=admin.lambodarautsav.org
